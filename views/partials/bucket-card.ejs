<article class="card hub-card bucket-card <%= item.completed_at ? 'hub-card--complete' : '' %>"
         id="bucket-item-<%= item.id %>"
         <% if (reorderable) { %>data-reorder-item data-reorder-id="<%= item.id %>"<% } %>>
  <% if (reorderable) { %>
    <%- include('reorder-controls', { label: `active dream ${item.title}` }) %>
  <% } %>

  <header class="hub-card__header">
    <div class="bucket-card__heading">
      <div class="bucket-card__labels">
        <span class="tag"><%= item.category %></span>
        <% if (item.is_favorite) { %>
          <span class="bucket-favorite">
            <span aria-hidden="true">★</span>
            <span class="visually-hidden">Favorite</span>
          </span>
        <% } %>
      </div>
      <h3 class="card__title"><%= item.title %></h3>
    </div>
    <% if (canEdit) { %>
      <form action="/bucket/<%= item.id %>/favorite" method="post"
            class="bucket-card__favorite-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button class="btn btn--outline" type="submit"
                aria-label="<%= item.is_favorite ? 'Remove' : 'Add' %> <%= item.title %> <%= item.is_favorite ? 'from' : 'to' %> favorites">
          <%= item.is_favorite ? 'Unfavorite' : 'Favorite' %>
        </button>
      </form>
    <% } %>
  </header>

  <p class="preserve-lines"><%= item.description %></p>
  <% if (item.target_date) { %>
    <p class="bucket-card__meta">
      <strong>Target:</strong>
      <time datetime="<%= item.target_date %>"><%= formatDate(item.target_date) %></time>
    </p>
  <% } %>

  <% if (item.completed_at) { %>
    <div class="bucket-completion-summary">
      <p>
        <strong>Completed</strong>
        <time datetime="<%= item.completed_at %>"><%= formatDate(item.completed_at) %></time>
      </p>
    </div>
    <div class="bucket-memory" aria-labelledby="memory-heading-<%= item.id %>">
      <h4 id="memory-heading-<%= item.id %>">Memory</h4>
      <% if (item.memory) { %>
        <p class="preserve-lines"><%= item.memory %></p>
      <% } else { %>
        <p class="bucket-memory__empty">No memory has been added yet.</p>
      <% } %>
    </div>
    <% if (canEdit) { %>
      <details class="item-editor bucket-memory-editor">
        <summary><%= item.memory ? 'Edit memory' : 'Add a memory' %></summary>
        <form action="/bucket/<%= item.id %>/memory" method="post" class="compact-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <label class="form-label" for="memory-<%= item.id %>">What do you want to remember?</label>
          <textarea class="form-textarea" id="memory-<%= item.id %>" name="memory"
                    maxlength="8000"><%= item.memory || '' %></textarea>
          <button class="btn btn--primary" type="submit">Save memory</button>
        </form>
      </details>
    <% } %>
  <% } %>

  <div class="vote-grid" role="group" aria-label="Votes for <%= item.title %>">
    <% ['partner_one', 'partner_two'].forEach((slot) => { %>
      <% if (canEdit) { %>
        <form action="/bucket/<%= item.id %>/vote" method="post" class="compact-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input type="hidden" name="voter_slot" value="<%= slot %>" />
          <label class="form-label" for="vote-<%= item.id %>-<%= slot %>"><%= labels[slot] %></label>
          <select class="form-select" id="vote-<%= item.id %>-<%= slot %>" name="vote">
            <% ['yes', 'maybe', 'not_yet'].forEach((vote) => { %>
              <option value="<%= vote %>" <%= item[`${slot}_vote`] === vote ? 'selected' : '' %>>
                <%= vote.replace('_', ' ') %>
              </option>
            <% }) %>
          </select>
          <button class="btn btn--outline" type="submit">Save vote</button>
          <% if (item[`${slot}_vote`]) { %>
            <small>Choose the same vote again to remove it.</small>
          <% } %>
        </form>
      <% } else { %>
        <p>
          <strong><%= labels[slot] %>:</strong>
          <%= item[`${slot}_vote`]?.replace('_', ' ') || 'No vote' %>
        </p>
      <% } %>
    <% }) %>
  </div>

  <% if (canEdit) { %>
    <% if (item.completed_at) { %>
      <form action="/bucket/<%= item.id %>/completion" method="post"
            class="compact-form bucket-reopen-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="completed" value="0" />
        <button class="btn btn--outline" type="submit">Reopen this dream</button>
      </form>
    <% } else { %>
      <form action="/bucket/<%= item.id %>/completion" method="post"
            class="compact-form bucket-completion-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="completed" value="1" />
        <div class="form-group">
          <label class="form-label" for="complete-<%= item.id %>">When did you do it?</label>
          <input class="form-input" id="complete-<%= item.id %>" name="completed_at"
                 type="date" value="<%= today %>"
                 aria-describedby="complete-help-<%= item.id %>" required />
          <small class="form-help" id="complete-help-<%= item.id %>">
            Today is filled in for you. Change it if this happened earlier.
          </small>
        </div>
        <button class="btn btn--primary" type="submit">Mark as completed</button>
      </form>
    <% } %>

    <details class="item-editor">
      <summary>Edit item details</summary>
      <form action="/bucket/<%= item.id %>" method="post" class="admin-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <%- include('bucket-fields', {
          item,
          prefix: `bucket-${item.id}`
        }) %>
        <button type="submit" class="btn btn--primary">Save changes</button>
      </form>
      <form action="/bucket/<%= item.id %>/delete" method="post"
            class="admin-danger" data-confirm="Delete this Bucket List item?">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button type="submit" class="btn btn--outline">Delete item</button>
      </form>
    </details>
  <% } %>
</article>
