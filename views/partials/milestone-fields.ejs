<div class="admin-grid">
  <div class="form-group">
    <label class="form-label" for="<%= prefix %>-date">Date label</label>
    <input class="form-input" id="<%= prefix %>-date" name="date" maxlength="100"
           value="<%= milestone.date %>" required />
  </div>
  <div class="form-group">
    <label class="form-label" for="<%= prefix %>-title">Title</label>
    <input class="form-input" id="<%= prefix %>-title" name="title" maxlength="150"
           value="<%= milestone.title %>" required />
  </div>
  <div class="form-group">
    <label class="form-label" for="<%= prefix %>-emoji">Emoji</label>
    <input class="form-input" id="<%= prefix %>-emoji" name="emoji" maxlength="32"
           value="<%= milestone.emoji %>" required />
  </div>
  <div class="form-group admin-grid__wide">
    <label class="form-label" for="<%= prefix %>-description">Description</label>
    <textarea class="form-textarea" id="<%= prefix %>-description" name="description"
              maxlength="2000" required><%= milestone.description %></textarea>
  </div>
  <div class="form-group">
    <label class="form-label" for="<%= prefix %>-url">Optional URL</label>
    <input class="form-input" id="<%= prefix %>-url" name="link_url" type="url"
           maxlength="1000" value="<%= milestone.link_url || '' %>" />
  </div>
  <fieldset class="form-group admin-grid__wide timeline-photo-editor">
    <legend class="form-label">Milestone photo</legend>
    <% if (photoUrl) { %>
      <div class="timeline-photo-editor__current">
        <img src="<%= photoUrl %>"
             alt="Current photo for <%= milestone.title %>" />
        <p><strong>Current photo</strong><br />Upload a new photo below to replace it.</p>
      </div>
    <% } else { %>
      <p class="timeline-photo-editor__empty">No photo has been added yet.</p>
    <% } %>
    <label class="form-label" for="<%= prefix %>-photo">
      <%= photoUrl ? 'Choose a replacement photo' : 'Choose a photo (optional)' %>
    </label>
    <input class="form-input" id="<%= prefix %>-photo" name="photo" type="file"
           accept="image/jpeg,image/png,image/webp,image/heic,image/heif,.heic,.heif" />
    <p class="form-help">
      JPEG, PNG, WebP, HEIC, or HEIF up to 20 MB. Apple HEIC/HEIF photos are
      converted to JPEG before storage.
    </p>
    <% if (photoUrl) { %>
      <label class="timeline-photo-editor__remove">
        <input type="checkbox" name="remove_photo" value="1" />
        <span>Remove the current photo when I save</span>
      </label>
      <p class="form-help">Choose a replacement or remove the current photo, not both.</p>
    <% } %>
  </fieldset>
</div>
