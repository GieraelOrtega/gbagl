<%- include('partials/head') %>
<%- include('partials/nav') %>
<main class="content-page bucket-page" id="main-content" tabindex="-1">
  <div class="container">
    <header class="page-header">
      <h1 class="page-header__title">Our Bucket List</h1>
      <p class="page-header__subtitle">Dream together, vote together, remember together.</p>
    </header>
    <% if (message) { %><div class="alert alert--success"><%= message %></div><% } %>
    <% if (error) { %><div class="alert alert--error"><%= error %></div><% } %>
    <% if (dbError) { %><div class="alert alert--warning"><%= dbError %></div><% } %>

    <% if (!dbError && canEdit) { %>
      <details class="card editor-panel">
        <summary>Add a dream</summary>
        <form action="/bucket" method="post" class="admin-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <%- include('partials/bucket-fields', {
            item: { title: '', description: '', category: 'other', target_date: '' },
            prefix: 'new-bucket-item'
          }) %>
          <button type="submit" class="btn btn--primary">Add to our list</button>
        </form>
      </details>
    <% } %>

    <% if (!dbError) { %>
      <section class="bucket-section bucket-section--active" aria-labelledby="active-dreams-heading">
        <header class="bucket-section__header">
          <div class="bucket-section__intro">
            <p class="section-eyebrow">Still dreaming</p>
            <div class="bucket-section__title-row">
              <h2 class="bucket-section__title" id="active-dreams-heading">Active Dreams</h2>
              <span class="bucket-count"
                    aria-label="<%= activeItems.length %> active <%= activeItems.length === 1 ? 'dream' : 'dreams' %>">
                <%= activeItems.length %>
              </span>
            </div>
            <p class="bucket-section__description">
              The adventures and moments we are still looking forward to.
            </p>
          </div>
          <% if (canEdit && activeItems.length > 1) { %>
            <%- include('partials/reorder-toolbar', {
              group: 'bucket-active',
              label: 'active dreams'
            }) %>
          <% } %>
        </header>

        <% if (activeItems.length > 0) { %>
          <div class="hub-grid bucket-grid"
               data-reorder-group="bucket-active"
               data-reorder-submit="list"
               data-reorder-url="/bucket/reorder">
            <% activeItems.forEach((item) => { %>
              <%- include('partials/bucket-card', {
                item,
                reorderable: canEdit && activeItems.length > 1
              }) %>
            <% }) %>
          </div>
        <% } else { %>
          <div class="empty-state bucket-empty-state">
            <h3>No active dreams right now</h3>
            <p>
              <% if (canEdit) { %>
                <%= completedItems.length > 0
                  ? 'Everything on the list is completed. Add a new dream whenever inspiration strikes.'
                  : 'Add the first dream you want to share.' %>
              <% } else { %>
                <%= completedItems.length > 0
                  ? 'Every saved dream has been completed.'
                  : 'No dreams have been added yet.' %>
              <% } %>
            </p>
          </div>
        <% } %>
      </section>

      <section class="bucket-section bucket-section--completed"
               aria-labelledby="completed-dreams-heading">
        <header class="bucket-section__header">
          <div class="bucket-section__intro">
            <p class="section-eyebrow">Made into memories</p>
            <div class="bucket-section__title-row">
              <h2 class="bucket-section__title" id="completed-dreams-heading">Completed</h2>
              <span class="bucket-count bucket-count--completed"
                    aria-label="<%= completedItems.length %> completed <%= completedItems.length === 1 ? 'dream' : 'dreams' %>">
                <%= completedItems.length %>
              </span>
            </div>
            <p class="bucket-section__description">
              The dreams we made happen, with the dates and memories we want to keep.
            </p>
          </div>
        </header>

        <% if (completedItems.length > 0) { %>
          <div class="hub-grid bucket-grid bucket-grid--completed">
            <% completedItems.forEach((item) => { %>
              <%- include('partials/bucket-card', { item, reorderable: false }) %>
            <% }) %>
          </div>
        <% } else { %>
          <div class="empty-state bucket-empty-state">
            <h3>No completed dreams yet</h3>
            <p>
              When a dream happens, mark it completed and its date and memory will live here.
            </p>
          </div>
        <% } %>
      </section>
    <% } %>
  </div>
</main>
<%- include('partials/footer') %>
